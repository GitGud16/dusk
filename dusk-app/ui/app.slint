import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Modal, Status, StatusKind, Timecode, ToolButton } from "widgets.slint";
import { ClipView, Timeline, TickView, TrackView } from "timeline.slint";
import { MediaBin, MediaView } from "media-bin.slint";
import { ClipProperties, ClipProps } from "properties.slint";
import { AboutDialog, MissingDialog, MissingView, Prompt, SequenceSettings } from "dialogs.slint";
import { ShortcutDialog, ShortcutView } from "shortcut-list.slint";
import { ClipEditorWindow, EditorProps, EditorSides } from "clip-editor.slint";
import { ExportDialog, ExportView } from "export-dialog.slint";
import { CompressDialog, CompressView } from "compress-dialog.slint";
import { SettingsDialog, SettingsView } from "settings-dialog.slint";

export { ClipView, TickView, TrackView, MediaView, ClipProps, ShortcutView }
export { ClipEditorWindow, EditorProps, EditorSides, ExportView, CompressView, SettingsView }
export { StatusKind, MissingView }

export component MainWindow inherits Window {
    title: root.window-title;
    icon: @image-url("../assets/dusk.svg");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 600px;
    background: Theme.bg-0;
    default-font-family: Theme.font-ui;
    default-font-size: Theme.font-body;
    forward-focus: keys;

    in property <string> window-title: "Dusk";

    // The latest preview frame, drawn by dusk-render at the preview's size in physical pixels.
    in property <image> preview-image;
    // Shown over the preview instead of a frame.
    in property <string> preview-message;
    // The preview's size in physical pixels, so frames are drawn 1:1.
    out property <int> preview-pixel-width: Math.round(preview.width / 1phx);
    out property <int> preview-pixel-height: Math.round(preview.height / 1phx);
    callback preview-resized(width: int, height: int);

    // The media bin.
    in property <[MediaView]> media;
    in property <int> selected-media: -1;
    // The selected media's place in the bin, -1 for none.
    in property <int> selected-media-row: -1;
    callback select-media(media: int);
    callback place-media-at-playhead(media: int);
    // Where media dragged from the bin onto `row` at `frame` would start, or -1; and the drop.
    callback snap-place(media: int, row: int, frame: int) -> int;
    callback place-media(media: int, row: int, frame: int);
    // Files are being dragged over the window from another application.
    in property <bool> files-hovering;

    // The selected clip's properties.
    in property <ClipProps> clip-props;
    callback set-clip-enabled(enabled: bool);
    callback set-clip-fill(fill: bool);
    callback set-clip-length(frames: int);
    callback set-clip-volume(decibels: float);
    callback set-clip-fades(fade-in: int, fade-out: int);
    callback unlink-clip();

    // The timeline.
    in property <[TrackView]> tracks;
    in property <int> video-rows;
    in property <[ClipView]> clips;
    in property <[TickView]> ticks;
    in property <int> playhead;
    in property <float> zoom: 1;
    in property <int> scroll;
    in property <int> selected-clip: -1;
    in property <int> selected-link;
    out property <float> timeline-width: timeline.tracks-width / 1px;
    callback timeline-resized(width: float);
    callback scrub(frame: int);
    callback scrub-end(frame: int);
    callback select-clip(clip: int);
    // A clip was double-clicked: it opens in the clip editor.
    callback open-clip(clip: int);
    callback trim(clip: int, start: bool, frame: int);
    callback snap-move(clip: int, frame: int, row: int) -> int;
    callback move-clip(clip: int, frame: int, row: int);
    callback toggle-lock(track: int);
    callback toggle-mute(track: int);
    callback scroll-by(frames: int);
    callback zoom-by(factor: float, frame: int);

    // The transport.
    in property <string> position-timecode: "00:00:00:00";
    in property <string> end-timecode: "00:00:00:00";
    in property <bool> playing;
    // The playback factor while playing, such as "2x"; empty at normal speed.
    in property <string> speed;
    // Whether the timeline has clips to play or export.
    in property <bool> has-clips;
    callback play-pause();

    // The export: whether one runs, and how far it got, from 0 to 1.
    in property <bool> exporting;
    in property <float> export-progress;
    // The export dialog.
    in property <bool> export-open;
    // The compress tool's dialog.
    in property <bool> compress-open;
    in property <CompressView> compress-view;
    callback compress-changed(what: string, value: int);
    callback compress-done(go: bool);
    in property <ExportView> export-view;
    callback export-changed(what: string, value: int);
    callback export-done(export: bool);

    // The status line: what just happened, or what went wrong.
    in property <string> status;
    in property <StatusKind> status-kind;

    // A question over the window.
    in property <bool> prompt-open;
    in property <string> prompt-title;
    in property <string> prompt-message;
    in property <[string]> prompt-answers;
    in property <int> prompt-destructive: -1;
    callback prompt-answered(index: int);

    // Sequence settings.
    in property <bool> sequence-settings-open;
    in property <[string]> rate-names;
    in property <int> sequence-rate;
    in property <int> sequence-width;
    in property <int> sequence-height;
    callback sequence-settings-done(apply: bool, rate: int, width: int, height: int);

    // A menu item or button stands for the action named `name` (see shortcuts.rs).
    callback action(name: string);
    // Every key press goes to the shortcut table; true when it was a shortcut.
    callback key(text: string, ctrl: bool, shift: bool, alt: bool) -> bool;
    // The shortcut list's dialog (see shortcut-list.slint).
    in property <bool> shortcuts-open;
    in property <[ShortcutView]> shortcut-rows;
    in property <int> shortcut-picked: -1;
    in property <int> shortcut-headings-above;
    in property <string> shortcut-note;
    in property <bool> shortcut-capturing;
    callback shortcut-search(text: string);
    callback shortcut-pick(row: int);
    callback shortcut-change();
    callback shortcut-remove();
    callback shortcut-restore();
    callback shortcut-restore-all();
    callback shortcut-close();
    // What in the user's shortcuts file Dusk could not read, if anything.
    in property <string> shortcut-problem;
    // The list of media files the project cannot find (see dialogs.slint).
    in property <bool> missing-open;
    in property <[MissingView]> missing-rows;
    in property <int> missing-picked;
    in property <string> missing-note;
    in property <StatusKind> missing-note-kind;
    callback missing-pick(row: int);
    callback missing-find();
    callback missing-close();
    // The About dialog (see dialogs.slint).
    in property <bool> about-open;
    in property <string> about-version;
    in property <string> releases-url;
    in property <bool> about-licenses;
    callback about-close();
    callback about-show-licenses();
    callback about-link-failed();
    // The Settings dialog (see settings-dialog.slint).
    in property <bool> settings-open;
    in property <SettingsView> settings-view;
    callback settings-changed(what: string, value: int);
    callback settings-close();

    // Media being dragged from the bin: which, and where the pointer is.
    property <int> dragged-media: -1;
    property <length> drag-x;
    property <length> drag-y;

    // Dusk is dark only (THEME.md), whatever the system's choice, which Slint's own widget in
    // the About dialog would otherwise follow.
    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    // Gives the keyboard back to the shortcuts after a field or a button had it.
    public function take-keys() {
        keys.focus();
    }

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "New project";
                activated => {
                    root.action("new-project");
                }
            }
            MenuItem {
                title: "Open project…";
                activated => {
                    root.action("open-project");
                }
            }
            MenuItem {
                title: "Save";
                activated => {
                    root.action("save");
                }
            }
            MenuItem {
                title: "Save as…";
                activated => {
                    root.action("save-as");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Import media…";
                activated => {
                    root.action("import");
                }
            }
            MenuItem {
                title: "Export…";
                enabled: root.has-clips && !root.exporting;
                activated => {
                    root.action("export");
                }
            }
            MenuItem {
                title: "Compress a video…";
                enabled: !root.exporting;
                activated => {
                    root.action("compress-video");
                }
            }
            MenuItem {
                title: "Find missing media…";
                activated => {
                    root.action("find-missing-media");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Settings…";
                activated => {
                    root.action("settings");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Quit";
                activated => {
                    root.action("quit");
                }
            }
        }
        Menu {
            title: "Edit";
            MenuItem {
                title: "Undo";
                activated => {
                    root.action("undo");
                }
            }
            MenuItem {
                title: "Redo";
                activated => {
                    root.action("redo");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Split at the playhead";
                activated => {
                    root.action("split");
                }
            }
            MenuItem {
                title: "Delete";
                activated => {
                    root.action("delete");
                }
            }
            MenuItem {
                title: "Ripple delete";
                activated => {
                    root.action("ripple-delete");
                }
            }
            MenuItem {
                title: "Delete this clip only";
                activated => {
                    root.action("delete-one");
                }
            }
            MenuItem {
                title: "Detach audio";
                activated => {
                    root.action("unlink");
                }
            }
            MenuItem {
                title: "Enable or disable the clip";
                activated => {
                    root.action("toggle-enabled");
                }
            }
            MenuItem {
                title: "Fit with bars or fill and crop";
                activated => {
                    root.action("toggle-fill");
                }
            }
            MenuItem {
                title: "Open in the clip editor";
                activated => {
                    root.action("open-clip-editor");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Place the selected media at the playhead";
                activated => {
                    root.action("place");
                }
            }
        }
        Menu {
            title: "Sequence";
            MenuItem {
                title: "Sequence settings…";
                activated => {
                    root.action("sequence-settings");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Zoom in";
                activated => {
                    root.action("zoom-in");
                }
            }
            MenuItem {
                title: "Zoom out";
                activated => {
                    root.action("zoom-out");
                }
            }
            MenuItem {
                title: "Fit the sequence";
                activated => {
                    root.action("zoom-fit");
                }
            }
        }
        Menu {
            title: "Help";
            MenuItem {
                title: "Keyboard shortcuts";
                activated => {
                    root.action("shortcut-list");
                }
            }
            MenuItem {
                title: "About Dusk";
                activated => {
                    root.action("about");
                }
            }
        }
    }

    // Whether a dialog is open over the window: only its controls take the keyboard then (see
    // `Modal`), and the keys go back to the shortcuts whenever one opens or closes.
    property <bool> modal-open: root.export-open || root.compress-open || root.prompt-open || root.sequence-settings-open || root.shortcuts-open || root.settings-open || root.about-open || root.missing-open;
    // A question that opens over a dialog takes the keys from the dialog's controls.
    changed prompt-open => {
        Modal.question = root.prompt-open;
        keys.focus();
    }
    changed modal-open => {
        Modal.open = root.modal-open;
        if root.shortcuts-open {
            shortcuts-dialog.focus-search();
        } else {
            keys.focus();
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            // Escape gives the keys back to the shortcuts from a control that had them.
            if event.text == Key.Escape && !self.has-focus {
                self.focus();
            }
            return root.key(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt) ? EventResult.accept : EventResult.reject;
        }

        VerticalLayout {
            // The toolbar: bg-1 with a 1px border below (elevation by background step).
            Rectangle {
                height: Theme.toolbar-height;
                background: Theme.bg-1;

                HorizontalLayout {
                    padding-left: Theme.panel-padding;
                    padding-right: Theme.panel-padding;
                    spacing: Theme.space-3;

                    // The logo: the mark beside the wordmark (THEME.md, "Logo").
                    HorizontalLayout {
                        spacing: Theme.space-2;

                        VerticalLayout {
                            alignment: center;

                            Image {
                                source: @image-url("../assets/dusk.svg");
                                width: Theme.icon-size;
                                height: Theme.icon-size;
                            }
                        }

                        Text {
                            text: "Dusk";
                            color: Theme.text-1;
                            font-size: Theme.font-title;
                            font-weight: Theme.weight-semibold;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    ToolButton {
                        y: (parent.height - self.height) / 2;
                        text: "Shortcuts";
                        clicked => {
                            root.action("shortcut-list");
                            keys.focus();
                        }
                    }

                    ToolButton {
                        y: (parent.height - self.height) / 2;
                        text: "Export";
                        primary: true;
                        enabled: root.has-clips && !root.exporting;
                        clicked => {
                            root.action("export");
                            keys.focus();
                        }
                    }
                }

                Rectangle {
                    y: parent.height - self.height;
                    height: Theme.border-width;
                    background: Theme.border;
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;

                bin := MediaBin {
                    width: Theme.side-panel-width;
                    media: root.media;
                    selected: root.selected-media;
                    selected-row: root.selected-media-row;
                    select(media) => {
                        root.select-media(media);
                    }
                    activate(media) => {
                        root.place-media-at-playhead(media);
                    }
                    import => {
                        root.action("import");
                        keys.focus();
                    }
                    drag-moved(media, x, y) => {
                        root.dragged-media = media;
                        root.drag-x = x;
                        root.drag-y = y;
                        timeline.media-hover(x, y);
                    }
                    drag-ended(media) => {
                        timeline.media-drop();
                        root.dragged-media = -1;
                    }
                }

                preview := Rectangle {
                    background: Theme.bg-0;

                    Image {
                        width: 100%;
                        height: 100%;
                        source: root.preview-image;
                        image-fit: contain;
                    }

                    Text {
                        x: Theme.space-6;
                        width: parent.width - 2 * Theme.space-6;
                        text: root.preview-message;
                        color: Theme.text-2;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    changed width => {
                        root.preview-resized(root.preview-pixel-width, root.preview-pixel-height);
                    }
                    changed height => {
                        root.preview-resized(root.preview-pixel-width, root.preview-pixel-height);
                    }
                }

                ClipProperties {
                    width: Theme.side-panel-width;
                    props: root.clip-props;
                    set-enabled(enabled) => {
                        root.set-clip-enabled(enabled);
                        keys.focus();
                    }
                    set-fill(fill) => {
                        root.set-clip-fill(fill);
                        keys.focus();
                    }
                    set-length(frames) => {
                        root.set-clip-length(frames);
                    }
                    set-volume(decibels) => {
                        root.set-clip-volume(decibels);
                        keys.focus();
                    }
                    set-fades(fade-in, fade-out) => {
                        root.set-clip-fades(fade-in, fade-out);
                    }
                    unlink => {
                        root.unlink-clip();
                        keys.focus();
                    }
                    open-editor => {
                        root.action("open-clip-editor");
                        keys.focus();
                    }
                    finished => {
                        keys.focus();
                    }
                }
            }

            // The transport bar.
            Rectangle {
                height: Theme.toolbar-height + Theme.space-2;
                background: Theme.bg-1;

                Rectangle {
                    height: Theme.border-width;
                    y: 0;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding-left: Theme.panel-padding;
                    padding-right: Theme.panel-padding;
                    spacing: Theme.space-3;

                    Timecode {
                        text: root.position-timecode;
                        color: Theme.text-1;
                    }

                    ToolButton {
                        y: (parent.height - self.height) / 2;
                        text: root.playing ? "Pause" : "Play";
                        enabled: root.has-clips;
                        clicked => {
                            root.play-pause();
                            keys.focus();
                        }
                    }

                    Text {
                        text: root.speed;
                        color: Theme.signal;
                        font-family: Theme.font-numeric;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    Timecode {
                        text: root.end-timecode;
                        color: Theme.text-2;
                    }
                }
            }

            timeline := Timeline {
                tracks: root.tracks;
                video-rows: root.video-rows;
                clips: root.clips;
                ticks: root.ticks;
                playhead: root.playhead;
                zoom: root.zoom;
                scroll: root.scroll;
                selected-clip: root.selected-clip;
                selected-link: root.selected-link;
                media-length: root.media-length-of(root.dragged-media);
                media-video: root.media-has-video(root.dragged-media);
                media-audio: root.media-has-audio(root.dragged-media);
                scrub(frame) => {
                    root.scrub(frame);
                }
                scrub-end(frame) => {
                    root.scrub-end(frame);
                }
                select-clip(clip) => {
                    root.select-clip(clip);
                    keys.focus();
                }
                open-clip(clip) => {
                    root.open-clip(clip);
                }
                trim(clip, start, frame) => {
                    root.trim(clip, start, frame);
                }
                snap-move(clip, frame, row) => {
                    return root.snap-move(clip, frame, row);
                }
                move-clip(clip, frame, row) => {
                    root.move-clip(clip, frame, row);
                }
                snap-place(row, frame) => {
                    return root.snap-place(root.dragged-media, row, frame);
                }
                place-media(row, frame) => {
                    root.place-media(root.dragged-media, row, frame);
                }
                toggle-lock(track) => {
                    root.toggle-lock(track);
                    keys.focus();
                }
                toggle-mute(track) => {
                    root.toggle-mute(track);
                    keys.focus();
                }
                scroll-by(frames) => {
                    root.scroll-by(frames);
                }
                zoom-by(factor, frame) => {
                    root.zoom-by(factor, frame);
                }
                changed tracks-width => {
                    root.timeline-resized(self.tracks-width / 1px);
                }
            }

            // The status line.
            Rectangle {
                height: Theme.control-height;
                background: Theme.bg-1;

                Rectangle {
                    height: Theme.border-width;
                    y: 0;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding-left: Theme.panel-padding;
                    padding-right: Theme.panel-padding;
                    spacing: Theme.space-3;

                    Text {
                        text: root.status;
                        color: Status.color-of(root.status-kind);
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    if root.exporting: Rectangle {
                        width: 160px;
                        height: 6px;
                        y: (parent.height - self.height) / 2;
                        border-radius: self.height / 2;
                        background: Theme.bg-3;

                        Rectangle {
                            x: 0;
                            width: parent.width * Math.clamp(root.export-progress, 0, 1);
                            border-radius: parent.border-radius;
                            background: Theme.primary;
                        }
                    }

                    if root.exporting: ToolButton {
                        y: (parent.height - self.height) / 2;
                        height: Theme.control-height - Theme.space-1;
                        text: "Cancel";
                        clicked => {
                            root.action("cancel-export");
                            keys.focus();
                        }
                    }
                }
            }
        }

        // The media being dragged, under the pointer.
        if root.dragged-media >= 0: Rectangle {
            x: root.drag-x - root.absolute-position.x + Theme.space-3;
            y: root.drag-y - root.absolute-position.y + Theme.space-3;
            width: label.preferred-width + 2 * Theme.space-2;
            height: Theme.control-height;
            border-radius: Theme.radius-control;
            border-width: Theme.border-width;
            border-color: Theme.primary-bright;
            background: Theme.bg-2;

            label := Text {
                text: root.media-name-of(root.dragged-media);
                color: Theme.text-1;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Files from another application, over the window.
        if root.files-hovering: Rectangle {
            background: Theme.scrim;
            border-width: Theme.focus-width;
            border-color: Theme.primary-bright;

            Text {
                text: "Drop to import";
                color: Theme.text-1;
                font-size: Theme.font-heading;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.compress-open: CompressDialog {
            view: root.compress-view;
            changed(what, value) => {
                root.compress-changed(what, value);
            }
            done(go) => {
                root.compress-done(go);
                keys.focus();
            }
            finished => {
                keys.focus();
            }
        }

        // Always there, so the window can give its search field the keys; shown when open.
        shortcuts-dialog := ShortcutDialog {
            visible: root.shortcuts-open;
            rows: root.shortcut-rows;
            picked: root.shortcut-picked;
            headings-above: root.shortcut-headings-above;
            note: root.shortcut-note;
            capturing: root.shortcut-capturing;
            problem: root.shortcut-problem;
            search(text) => {
                root.shortcut-search(text);
            }
            pick(row) => {
                root.shortcut-pick(row);
            }
            change => {
                root.shortcut-change();
            }
            remove => {
                root.shortcut-remove();
            }
            restore => {
                root.shortcut-restore();
            }
            restore-all => {
                root.shortcut-restore-all();
            }
            close => {
                root.shortcut-close();
            }
        }

        if root.export-open: ExportDialog {
            view: root.export-view;
            changed(what, value) => {
                root.export-changed(what, value);
            }
            done(export) => {
                root.export-done(export);
                keys.focus();
            }
            finished => {
                keys.focus();
            }
        }

        if root.missing-open: MissingDialog {
            rows: root.missing-rows;
            picked: root.missing-picked;
            note: root.missing-note;
            note-kind: root.missing-note-kind;
            pick(row) => {
                root.missing-pick(row);
            }
            find => {
                root.missing-find();
            }
            close => {
                root.missing-close();
                keys.focus();
            }
        }

        if root.about-open: AboutDialog {
            version: root.about-version;
            releases: root.releases-url;
            licenses-available: root.about-licenses;
            licenses => {
                root.about-show-licenses();
            }
            close => {
                root.about-close();
                keys.focus();
            }
            link-failed => {
                root.about-link-failed();
            }
        }

        if root.settings-open: SettingsDialog {
            view: root.settings-view;
            changed(what, value) => {
                root.settings-changed(what, value);
            }
            close => {
                root.settings-close();
                keys.focus();
            }
            finished => {
                keys.focus();
            }
        }

        if root.sequence-settings-open: SequenceSettings {
            rates: root.rate-names;
            rate: root.sequence-rate;
            picture-width: root.sequence-width;
            picture-height: root.sequence-height;
            done(apply, rate, width, height) => {
                root.sequence-settings-done(apply, rate, width, height);
                keys.focus();
            }
            finished => {
                keys.focus();
            }
        }

        // Last, so a question (closing with unsaved changes, say) shows over any dialog open
        // at the time; it takes the keys first too.
        if root.prompt-open: Prompt {
            title: root.prompt-title;
            message: root.prompt-message;
            answers: root.prompt-answers;
            destructive: root.prompt-destructive;
            answered(index) => {
                root.prompt-answered(index);
            }
        }
    }

    // Lookups in the media list for the item being dragged.
    pure function media-length-of(id: int) -> int {
        return root.media-item(id).length;
    }
    pure function media-has-video(id: int) -> bool {
        return root.media-item(id).video;
    }
    pure function media-has-audio(id: int) -> bool {
        return root.media-item(id).audio;
    }
    pure function media-name-of(id: int) -> string {
        return root.media-item(id).name;
    }
    pure callback media-item(id: int) -> MediaView;
}
